[Unit]
Description=Cricket Stream FastAPI Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=stream
Group=stream
WorkingDirectory=/opt/cricket-stream/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cricket-stream/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

