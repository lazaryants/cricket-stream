APP_NAME="Cricket Stream Platform"
APP_VERSION="0.1.0"
DEBUG=false

HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+asyncpg://cricket_stream:CHANGE_ME@127.0.0.1/cricket_stream

JWT_SECRET_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

FFMPEG_PATH=/usr/bin/ffmpeg
STREAMLINK_PATH=/opt/cricket-stream/backend/.venv/bin/streamlink
YT_DLP_PATH=/opt/cricket-stream/backend/.venv/bin/yt-dlp

MAX_STREAMS=16
PREVIEW_INTERVAL=10
HLS_DIR=/opt/cricket-stream/var/hls
HLS_SEGMENT_TIME=4
HLS_LIST_SIZE=6
MEDIA_STARTUP_GRACE_SECONDS=45
MEDIA_STALL_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
